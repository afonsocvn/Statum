<!DOCTYPE html>
<html lang="pt">
<head>
  <title>Statum - <%= country.name %></title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>

  <main>
    <h1><%= country.flag %> <%= country.name %></h1>
    <p><%= country.continent %> — <%= country.population.toLocaleString('pt-PT') %> habitantes</p>

    <h2>Regiões</h2>
    <ul>
      <% regions.forEach(function(region) { %>
        <li><%= region.name %><%= region.is_capital ? ' (capital)' : '' %></li>
      <% }) %>
    </ul>

    <p><a href="/countries">← Voltar à lista de países</a></p>
  </main>
</body>
</html>
